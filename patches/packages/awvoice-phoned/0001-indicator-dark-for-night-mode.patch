+void indicator_set_dark(struct indicator *ind, int dark)
+{
+	dark = !!dark;
+	if (ind->dark == dark)
+		return;
+	ind->dark = dark;
+	ind->lit = -1;		/* the next step writes again: dark now, or the pattern from its lit half */
+}
