--- a/awvoice-phoned/tests/test_indicator.c
+++ b/awvoice-phoned/tests/test_indicator.c
@@ -94,6 +94,29 @@ int main(void)
 	indicator_step(&ind, &st, 8500);
 	assert(ind.state == IND_READY && level(led) == '1');
 
+	/* held dark (night mode): off at once and kept off, the state still followed; the read-back holds the
+	 * dark against another writer; released, the pattern starts again from its lit half */
+	indicator_set_dark(&ind, 1);
+	indicator_step(&ind, &st, 9000);
+	assert(ind.state == IND_READY && level(led) == '0');
+	st = status(1, 0, 1);
+	indicator_step(&ind, &st, 9100);			/* a call rings in the dark: no blink */
+	assert(ind.state == IND_RING && level(led) == '0');
+	indicator_step(&ind, &st, 9300);
+	assert(level(led) == '0');
+	if (pwrite(ind.fd, "1", 1, 0) != 1)
+		return 1;
+	indicator_step(&ind, &st, 9400);			/* another program lights it: put out again */
+	assert(level(led) == '0');
+	indicator_set_dark(&ind, 1);				/* asked again: no change */
+	assert(ind.dark == 1);
+	indicator_set_dark(&ind, 0);
+	indicator_step(&ind, &st, 9500);			/* released while ringing: the blink restarts lit */
+	assert(ind.state == IND_RING && level(led) == '1');
+	st = status(1, 0, 0);
+	indicator_step(&ind, &st, 9600);
+	assert(ind.state == IND_READY && level(led) == '1');
+
 	int rfd = dup(ind.fd);			/* close() takes the descriptor the levels were read through */
 	char last = 'x';
 
