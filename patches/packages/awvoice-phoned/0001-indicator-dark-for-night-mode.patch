 	return action_reply(ctx, req, err, st.off_hook);
 }
 
+enum { ID_DARK, ID_MAX };
+static const struct blobmsg_policy indicator_policy[ID_MAX] = { [ID_DARK] = { .name = "dark", .type = BLOBMSG_TYPE_BOOL } };
+
+static int m_indicator_dark(struct ubus_context *ctx, struct ubus_object *obj, struct ubus_request_data *req, const char *method, struct blob_attr *msg)
+{
+	struct blob_attr *tb[ID_MAX];
+	int dark;
+
+	(void)obj; (void)method;
+	blobmsg_parse(indicator_policy, ID_MAX, tb, blob_data(msg), blob_len(msg));
+	if (!tb[ID_DARK])
+		return UBUS_STATUS_INVALID_ARGUMENT;
+	if (!the_api->indicator_dark)
+		return UBUS_STATUS_NOT_SUPPORTED;
+	dark = blobmsg_get_bool(tb[ID_DARK]);
+	the_api->indicator_dark(the_api->ctx, dark);
+	blob_buf_init(&reply_buf, 0);
+	blobmsg_add_u8(&reply_buf, "ok", 1);
+	blobmsg_add_u8(&reply_buf, "dark", dark);
+	return send_reply(ctx, req);
+}
