--- a/luci-app-cw-led/root/etc/uci-defaults/90-cw-led
+++ b/luci-app-cw-led/root/etc/uci-defaults/90-cw-led
@@ -40,6 +40,19 @@ if ! uci -q get cw-led.global >/dev/null; then
 	EOF
 fi
 
+# Night mode learned the phone LED. A config written before that has no 'phone' in
+# the exempt list, which would now put the phone lamp out at night without anyone
+# asking: add it once, so the lamp behaves as before until it is unticked. The
+# marker keeps a later run (every upgrade) from adding it back.
+if uci -q get cw-led.night >/dev/null && [ -z "$(uci -q get cw-led.night.phone_known)" ]; then
+	case " $(uci -q get cw-led.night.exempt) " in
+	*" phone "*) ;;
+	*) uci -q add_list cw-led.night.exempt=phone ;;
+	esac
+	uci -q set cw-led.night.phone_known=1
+	uci -q commit cw-led
+fi
+
 /etc/init.d/cw-led enable 2>/dev/null
 /etc/init.d/rpcd reload 2>/dev/null
 
