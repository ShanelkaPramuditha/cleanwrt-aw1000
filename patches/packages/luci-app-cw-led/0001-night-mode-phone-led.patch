 # --- night mode ------------------------------------------------------------------
@@ -299,6 +301,45 @@ concept_off() {
 	esac
 }
 
+# The phone LED belongs to the phone service (awvoice-phoned), which restores the level
+# whenever anything else writes it. Night mode therefore asks that service to hold the
+# lamp dark (`ubus call awvoice indicator_dark`), a memory-only hold. It is sent on a
+# change, and again about once a minute while the hold is wanted, because the service
+# forgets it when it restarts. Without the phone service (or with a build that lacks the
+# method) the call fails, nothing else happens, and it is tried again a minute later.
+phone_set_dark() { # 1 | 0
+	local v=false
+	[ "$1" = 1 ] && v=true
+	command -v ubus >/dev/null 2>&1 || return 1
+	ubus -t 2 call awvoice indicator_dark "{\"dark\":$v}" >/dev/null 2>&1
+}
+
+phone_update() {
+	local want=0
+	if [ "$NIGHT_STATE" = on ] && ! is_exempt phone; then
+		want=1
+	fi
+	if [ "$want" != "$PHONE_DARK" ]; then
+		[ "$TICK_NO" -ge "$PHONE_RETRY_AT" ] || return 0
+	elif [ "$want" = 1 ] && [ $((TICK_NO % 12)) -eq 0 ]; then
+		:   # re-assert: the service may have restarted since
+	else
+		return 0
+	fi
+	if phone_set_dark "$want"; then
+		if [ "$want" != "$PHONE_DARK" ] && [ "$PHONE_DARK" != unknown -o "$want" = 1 ]; then
+			if [ "$want" = 1 ]; then
+				logger -t cw-led "phone LED held dark (night mode)"
+			else
+				logger -t cw-led "phone LED released"
+			fi
+		fi
+		PHONE_DARK=$want
+	else
+		PHONE_RETRY_AT=$((TICK_NO + 12))
+	fi
+}
+
 night_update() {
 	local active=0 concept
 	if [ "$night_enabled" = 1 ] && cw_led_in_window "$night_start" "$night_end"; then
@@ -320,6 +361,7 @@ night_update() {
 		NIGHT_STATE=off
 		logger -t cw-led "night mode OFF"
 	fi
+	phone_update
 }
 
